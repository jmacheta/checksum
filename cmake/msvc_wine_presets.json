{
    "version": 8,
    "include": [
        "common_presets.json"
    ],
    "configurePresets": [
        {
            "name": "windows-msvc-wine",
            "displayName": "Windows x64 (MSVC in Wine)",
            "description": "Cross build with MSVC from msvc-wine installed in ~/.local/opt/msvc, tests run in Wine; static CRT to match GoogleTest's default and to need no debug CRT DLLs in Wine, /Z7 to avoid mspdbsrv",
            "inherits": "common",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_SYSTEM_PROCESSOR": "AMD64",
                "CMAKE_C_COMPILER": "$env{HOME}/.local/opt/msvc/bin/x64/cl",
                "CMAKE_CXX_COMPILER": "$env{HOME}/.local/opt/msvc/bin/x64/cl",
                "CMAKE_LINKER": "$env{HOME}/.local/opt/msvc/bin/x64/link",
                "CMAKE_AR": "$env{HOME}/.local/opt/msvc/bin/x64/lib",
                "CMAKE_RC_COMPILER": "$env{HOME}/.local/opt/msvc/bin/x64/rc",
                "CMAKE_MT": "$env{HOME}/.local/opt/msvc/bin/x64/mt",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded",
                "CMAKE_CROSSCOMPILING_EMULATOR": "wine"
            },
            "environment": {
                "CFLAGS": "/W4 /permissive- /utf-8",
                "CXXFLAGS": "/W4 /permissive- /Zc:__cplusplus /utf-8",
                "WINEDEBUG": "-all"
            }
        },
        {
            "name": "windows-clang-cl-wine",
            "displayName": "Windows x64 (clang-cl in Wine)",
            "description": "Cross build with clang-cl 21 and lld-link against the MSVC headers and libraries of msvc-wine in ~/.local/opt/msvc, tests run in Wine. That STL wants Clang 22 (_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH) and its <format> fails under Clang 21, so no examples (they use <print>)",
            "inherits": "common",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_SYSTEM_PROCESSOR": "AMD64",
                "CMAKE_C_COMPILER": "clang-cl-21",
                "CMAKE_CXX_COMPILER": "clang-cl-21",
                "CMAKE_LINKER": "lld-link",
                "CMAKE_AR": "llvm-lib-21",
                "CMAKE_RC_COMPILER": "llvm-rc-21",
                "CMAKE_MT": "llvm-mt-21",
                "CMAKE_EXE_LINKER_FLAGS": "/winsysroot:$env{HOME}/.local/opt/msvc",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded",
                "CMAKE_CROSSCOMPILING_EMULATOR": "wine",
                "CHECKSUM_EXAMPLES": "OFF"
            },
            "environment": {
                "CHECKSUM_CLANG_CL_FLAGS": "/winsysroot $env{HOME}/.local/opt/msvc -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH /W4 /permissive- /utf-8 -Wpedantic -Wunused-parameter -Winit-self -Wcast-align -Wconversion -Wnull-dereference -Wsign-conversion",
                "CFLAGS": "$env{CHECKSUM_CLANG_CL_FLAGS}",
                "CXXFLAGS": "$env{CHECKSUM_CLANG_CL_FLAGS} /Zc:__cplusplus",
                "WINEDEBUG": "-all"
            }
        },
        {
            "name": "windows-msvc-arm64-wine",
            "displayName": "Windows ARM64 (MSVC in Wine, build only)",
            "description": "Cross build for ARM64 with MSVC from msvc-wine installed in ~/.local/opt/msvc; Wine cannot run the binaries, so there is no test step",
            "inherits": "windows-msvc-wine",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "ARM64",
                "CMAKE_C_COMPILER": "$env{HOME}/.local/opt/msvc/bin/arm64/cl",
                "CMAKE_CXX_COMPILER": "$env{HOME}/.local/opt/msvc/bin/arm64/cl",
                "CMAKE_LINKER": "$env{HOME}/.local/opt/msvc/bin/arm64/link",
                "CMAKE_AR": "$env{HOME}/.local/opt/msvc/bin/arm64/lib",
                "CMAKE_RC_COMPILER": "$env{HOME}/.local/opt/msvc/bin/arm64/rc",
                "CMAKE_MT": "$env{HOME}/.local/opt/msvc/bin/arm64/mt",
                "CMAKE_CROSSCOMPILING_EMULATOR": null,
                "CMAKE_GTEST_DISCOVER_TESTS_DISCOVERY_MODE": "PRE_TEST"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc-wine-debug",
            "displayName": "all [Debug]",
            "configurePreset": "windows-msvc-wine",
            "configuration": "Debug"
        },
        {
            "name": "windows-clang-cl-wine-debug",
            "displayName": "all [Debug]",
            "configurePreset": "windows-clang-cl-wine",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-arm64-wine-debug",
            "displayName": "all [Debug]",
            "configurePreset": "windows-msvc-arm64-wine",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "windows-msvc-wine-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "windows-msvc-wine",
            "configuration": "Debug"
        },
        {
            "name": "windows-clang-cl-wine-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "windows-clang-cl-wine",
            "configuration": "Debug"
        }
    ],
    "workflowPresets": [
        {
            "name": "windows-msvc-wine",
            "displayName": "Windows x64 (MSVC in Wine)",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "windows-msvc-wine"
                },
                {
                    "type": "build",
                    "name": "windows-msvc-wine-debug"
                },
                {
                    "type": "test",
                    "name": "windows-msvc-wine-debug"
                }
            ]
        },
        {
            "name": "windows-clang-cl-wine",
            "displayName": "Windows x64 (clang-cl in Wine)",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "windows-clang-cl-wine"
                },
                {
                    "type": "build",
                    "name": "windows-clang-cl-wine-debug"
                },
                {
                    "type": "test",
                    "name": "windows-clang-cl-wine-debug"
                }
            ]
        }
    ]
}
