{
    "version": 8,
    "include": [
        "common_presets.json"
    ],
    "configurePresets": [
        {
            "name": "cross-common",
            "hidden": true,
            "inherits": "gcc-clang-common",
            "description": "Cross build for Linux whose tests run in QEMU user mode: executables are linked statically, so QEMU needs no target sysroot; -cpu max emulates every optional instruction-set extension, so the tests run every instruction-set preset of the architecture",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Linux"
            },
            "environment": {
                "LDFLAGS": "-static -Wl,--gc-sections"
            }
        },
        {
            "name": "cross-aarch64-base",
            "hidden": true,
            "inherits": "cross-common",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "aarch64",
                "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
                "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++",
                "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-aarch64;-cpu;max"
            }
        },
        {
            "name": "cross-aarch64be-base",
            "hidden": true,
            "inherits": "cross-common",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "aarch64_be",
                "CMAKE_C_COMPILER": "aarch64_be-none-linux-gnu-gcc",
                "CMAKE_CXX_COMPILER": "aarch64_be-none-linux-gnu-g++",
                "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-aarch64_be;-cpu;max"
            }
        },
        {
            "name": "cross-arm-base",
            "hidden": true,
            "inherits": "cross-common",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "arm",
                "CMAKE_C_COMPILER": "arm-linux-gnueabihf-gcc",
                "CMAKE_CXX_COMPILER": "arm-linux-gnueabihf-g++",
                "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-arm;-cpu;max"
            }
        },
        {
            "name": "cross-riscv64-base",
            "hidden": true,
            "inherits": "cross-common",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "riscv64",
                "CMAKE_C_COMPILER": "riscv64-linux-gnu-gcc",
                "CMAKE_CXX_COMPILER": "riscv64-linux-gnu-g++",
                "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-riscv64;-cpu;max"
            }
        },
        {
            "name": "cross-aarch64",
            "displayName": "AArch64 Linux in QEMU",
            "description": "AArch64 cross build with -march=armv8-a: generic and every AArch64 preset (aarch64_crc, aarch64_pmull) compiled in; tests run in QEMU with -cpu max",
            "inherits": "cross-aarch64-base",
            "environment": {
                "CHECKSUM_EXTRA_CFLAGS": "-march=armv8-a",
                "CHECKSUM_EXTRA_CXXFLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "cross-aarch64be",
            "displayName": "Big-endian AArch64 Linux in QEMU",
            "description": "Big-endian AArch64 cross build with -march=armv8-a+crc+crypto: generic and the AArch64 presets, whose NEON and PMULL kernels are off on big-endian (the CRC instructions stay); tests run in QEMU_be",
            "inherits": "cross-aarch64be-base",
            "environment": {
                "CHECKSUM_EXTRA_CFLAGS": "-march=armv8-a+crc+crypto",
                "CHECKSUM_EXTRA_CXXFLAGS": "-march=armv8-a+crc+crypto"
            }
        },
        {
            "name": "cross-arm-crc32",
            "displayName": "32-bit Arm Linux in QEMU (CRC extension build)",
            "description": "32-bit Arm (hard float) cross build with -march=armv8-a+crc -mfpu=neon-fp-armv8: the thumb2 presets take the build's own NEON and CRC extension; tests run in QEMU",
            "inherits": "cross-arm-base",
            "environment": {
                "CHECKSUM_EXTRA_CFLAGS": "-march=armv8-a+crc -mfpu=neon-fp-armv8",
                "CHECKSUM_EXTRA_CXXFLAGS": "-march=armv8-a+crc -mfpu=neon-fp-armv8"
            }
        },
        {
            "name": "cross-arm",
            "displayName": "32-bit Arm Linux in QEMU",
            "description": "32-bit Arm (hard float) cross build with -mfpu=vfpv3-d16: the thumb2 presets add their own options (NEON, armv8-a+crc); tests run in QEMU. Debug stays at -O0 here so that the inline assembly is built without optimization",
            "inherits": "cross-arm-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-g -O0 -D_GLIBCXX_ASSERTIONS -fstack-protector-strong -ftrivial-auto-var-init=pattern",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -O0 -D_GLIBCXX_ASSERTIONS -fstack-protector-strong -ftrivial-auto-var-init=pattern"
            },
            "environment": {
                "CHECKSUM_EXTRA_CFLAGS": "-mfpu=vfpv3-d16",
                "CHECKSUM_EXTRA_CXXFLAGS": "-mfpu=vfpv3-d16"
            }
        },
        {
            "name": "cross-riscv64",
            "displayName": "RISC-V 64 Linux in QEMU",
            "description": "Cross build for RISC-V 64 Linux (rv64gc): generic and the riscv_zbc and riscv_v presets compiled in; tests run in QEMU user mode with -cpu max",
            "inherits": "cross-riscv64-base",
            "environment": {
                "CHECKSUM_EXTRA_CFLAGS": "-march=rv64gc",
                "CHECKSUM_EXTRA_CXXFLAGS": "-march=rv64gc"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cross-aarch64-debug",
            "displayName": "all [Debug]",
            "configurePreset": "cross-aarch64",
            "configuration": "Debug"
        },
        {
            "name": "cross-aarch64be-debug",
            "displayName": "all [Debug]",
            "configurePreset": "cross-aarch64be",
            "configuration": "Debug"
        },
        {
            "name": "cross-arm-crc32-debug",
            "displayName": "all [Debug]",
            "configurePreset": "cross-arm-crc32",
            "configuration": "Debug"
        },
        {
            "name": "cross-arm-debug",
            "displayName": "all [Debug]",
            "configurePreset": "cross-arm",
            "configuration": "Debug"
        },
        {
            "name": "cross-riscv64-debug",
            "displayName": "all [Debug]",
            "configurePreset": "cross-riscv64",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "cross-aarch64-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "cross-aarch64",
            "configuration": "Debug",
            "environment": {
                "CHECKSUM_EXPECTED_ISA": "aarch64_pmull"
            }
        },
        {
            "name": "cross-aarch64be-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "cross-aarch64be",
            "configuration": "Debug",
            "environment": {
                "CHECKSUM_EXPECTED_ISA": "aarch64_pmull"
            }
        },
        {
            "name": "cross-arm-crc32-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "cross-arm-crc32",
            "configuration": "Debug",
            "environment": {
                "CHECKSUM_EXPECTED_ISA": "thumb2_crc"
            }
        },
        {
            "name": "cross-arm-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "cross-arm",
            "configuration": "Debug",
            "environment": {
                "CHECKSUM_EXPECTED_ISA": "thumb2_crc"
            }
        },
        {
            "name": "cross-riscv64-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "cross-riscv64",
            "configuration": "Debug"
        }
    ],
    "workflowPresets": [
        {
            "name": "cross-aarch64",
            "displayName": "AArch64 Linux in QEMU",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "cross-aarch64"
                },
                {
                    "type": "build",
                    "name": "cross-aarch64-debug"
                },
                {
                    "type": "test",
                    "name": "cross-aarch64-debug"
                }
            ]
        },
        {
            "name": "cross-aarch64be",
            "displayName": "Big-endian AArch64 Linux in QEMU",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "cross-aarch64be"
                },
                {
                    "type": "build",
                    "name": "cross-aarch64be-debug"
                },
                {
                    "type": "test",
                    "name": "cross-aarch64be-debug"
                }
            ]
        },
        {
            "name": "cross-arm-crc32",
            "displayName": "32-bit Arm Linux in QEMU (CRC extension build)",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "cross-arm-crc32"
                },
                {
                    "type": "build",
                    "name": "cross-arm-crc32-debug"
                },
                {
                    "type": "test",
                    "name": "cross-arm-crc32-debug"
                }
            ]
        },
        {
            "name": "cross-arm",
            "displayName": "32-bit Arm Linux in QEMU",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "cross-arm"
                },
                {
                    "type": "build",
                    "name": "cross-arm-debug"
                },
                {
                    "type": "test",
                    "name": "cross-arm-debug"
                }
            ]
        },
        {
            "name": "cross-riscv64",
            "displayName": "RISC-V 64 Linux in QEMU",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "cross-riscv64"
                },
                {
                    "type": "build",
                    "name": "cross-riscv64-debug"
                },
                {
                    "type": "test",
                    "name": "cross-riscv64-debug"
                }
            ]
        }
    ]
}
