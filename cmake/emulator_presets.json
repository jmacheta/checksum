            "configurePreset": "cross-riscv64-portable",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "cross-aarch64-pmull-debug",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "cross-aarch64-pmull",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
