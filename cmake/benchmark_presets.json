{
    "version": 8,
    "include": [
        "common_presets.json"
    ],
    "configurePresets": [
        {
            "name": "bench-common",
            "hidden": true,
            "cacheVariables": {
                "CHECKSUM_BENCHMARKS": "ON",
                "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG"
            },
            "environment": {
                "CHECKSUM_EXTRA_CFLAGS": "-march=native",
                "CHECKSUM_EXTRA_CXXFLAGS": "-march=native"
            }
        },
        {
            "name": "native-gcc-bench",
            "displayName": "Linux native benchmarks (GCC)",
            "description": "Release -O2 -march=native benchmarks using GCC: every preset of the host is benchmarked where the benchmark names it; the flags affect only the portable loops",
            "inherits": [
                "bench-common",
                "gcc"
            ]
        },
        {
            "name": "native-clang-bench",
            "displayName": "Linux native benchmarks (Clang)",
            "description": "Release -O2 -march=native benchmarks using Clang: every preset of the host is benchmarked where the benchmark names it; the flags affect only the portable loops",
            "inherits": [
                "bench-common",
                "clang"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "native-gcc-bench",
            "displayName": "benchmarks [Release]",
            "configurePreset": "native-gcc-bench",
            "configuration": "Release",
            "targets": [
                "checksum_bench_crc",
                "checksum_bench_internet",
                "checksum_bench_fletcher",
                "checksum_bench_fletcher4",
                "checksum_bench_adler32",
                "checksum_bench_xxhash",
                "checksum_bench_xxh3",
                "checksum_bench_murmur3"
            ]
        },
        {
            "name": "native-clang-bench",
            "displayName": "benchmarks [Release]",
            "configurePreset": "native-clang-bench",
            "configuration": "Release",
            "targets": [
                "checksum_bench_crc",
                "checksum_bench_internet",
                "checksum_bench_fletcher",
                "checksum_bench_fletcher4",
                "checksum_bench_adler32",
                "checksum_bench_xxhash",
                "checksum_bench_xxh3",
                "checksum_bench_murmur3"
            ]
        }
    ]
}
