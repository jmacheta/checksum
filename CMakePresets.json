{
    "version": 8,
    "include": [
        "cmake/common_presets.json",
        "cmake/emulator_presets.json",
        "cmake/benchmark_presets.json",
        "cmake/msvc_wine_presets.json",
        "cmake/bare_metal_presets.json"
    ],
    "configurePresets": [
        {
            "name": "native-gcc",
            "displayName": "Linux native (GCC)",
            "description": "Native Linux build using GCC",
            "inherits": "gcc"
        },
        {
            "name": "native-clang",
            "displayName": "Linux native (Clang)",
            "description": "Native Linux build using Clang",
            "inherits": "clang"
        },
        {
            "name": "native-asan",
            "displayName": "Linux native (ASan+UBSan)",
            "description": "Native Linux build instrumented with AddressSanitizer and UndefinedBehaviorSanitizer, for tests",
            "inherits": "gcc-clang-common",
            "cacheVariables": {
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -Wl,--gc-sections"
            },
            "environment": {
                "CHECKSUM_GCC_WARNINGS": "",
                "CHECKSUM_EXTRA_CFLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -g -O1",
                "CHECKSUM_EXTRA_CXXFLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -g -O1"
            }
        },
        {
            "name": "native-gcc-no-exceptions",
            "displayName": "Linux native (GCC, -fno-exceptions -fno-rtti)",
            "description": "Native Linux build using GCC with exceptions and RTTI disabled in every target",
            "inherits": "native-gcc",
            "environment": {
                "CHECKSUM_EXTRA_CXXFLAGS": "-fno-exceptions -fno-rtti"
            }
        },
        {
            "name": "native-clang-libcxx",
            "displayName": "Linux native (Clang, libc++)",
            "description": "Native Linux build using Clang and libc++",
            "inherits": "native-clang",
            "environment": {
                "CHECKSUM_EXTRA_CXXFLAGS": "-stdlib=libc++"
            },
            "cacheVariables": {
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -Wl,--gc-sections"
            }
        },
        {
            "name": "macos-clang",
            "displayName": "macOS native (Apple Clang)",
            "description": "Native macOS build using the Xcode Clang and libc++; Apple's linker strips unused sections with -dead_strip",
            "inherits": "clang",
            "environment": {
                "LDFLAGS": "-Wl,-dead_strip"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows native (MSVC)",
            "description": "Native Windows x64 build using MSVC, from a developer command prompt (cl and ninja on PATH); static CRT to match GoogleTest's default",
            "inherits": "common",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
            },
            "environment": {
                "CFLAGS": "/W4 /permissive- /utf-8",
                "CXXFLAGS": "/W4 /permissive- /Zc:__cplusplus /utf-8"
            }
        },
        {
            "name": "windows-clang-cl",
            "displayName": "Windows native (clang-cl)",
            "description": "Native Windows x64 build using clang-cl and lld-link of Visual Studio's LLVM component, from a developer command prompt; static CRT to match GoogleTest's default",
            "inherits": "common",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_LINKER": "lld-link",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
            },
            "environment": {
                "CHECKSUM_CLANG_CL_FLAGS": "/W4 /permissive- /utf-8 -Wpedantic -Wunused-parameter -Winit-self -Wcast-align -Wconversion -Wnull-dereference -Wsign-conversion",
                "CFLAGS": "$env{CHECKSUM_CLANG_CL_FLAGS}",
                "CXXFLAGS": "$env{CHECKSUM_CLANG_CL_FLAGS} /Zc:__cplusplus"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "native-gcc-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-gcc",
            "configuration": "Debug"
        },
        {
            "name": "native-gcc-release",
            "displayName": "all [Release]",
            "configurePreset": "native-gcc",
            "configuration": "Release"
        },
        {
            "name": "native-clang-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-clang",
            "configuration": "Debug"
        },
        {
            "name": "native-clang-release",
            "displayName": "all [Release]",
            "configurePreset": "native-clang",
            "configuration": "Release"
        },
        {
            "name": "native-asan-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-asan",
            "configuration": "Debug"
        },
        {
            "name": "native-gcc-no-exceptions-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-gcc-no-exceptions",
            "configuration": "Debug"
        },
        {
            "name": "native-clang-libcxx-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-clang-libcxx",
            "configuration": "Debug"
        },
        {
            "name": "macos-clang-debug",
            "displayName": "all [Debug]",
            "configurePreset": "macos-clang",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "all [Debug]",
            "configurePreset": "windows-msvc",
            "configuration": "Debug"
        },
        {
            "name": "windows-clang-cl-debug",
            "displayName": "all [Debug]",
            "configurePreset": "windows-clang-cl",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "native-gcc-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "native-gcc",
            "configuration": "Debug"
        },
        {
            "name": "native-clang-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "native-clang",
            "configuration": "Debug"
        },
        {
            "name": "native-asan-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug, ASan+UBSan]",
            "configurePreset": "native-asan",
            "configuration": "Debug"
        },
        {
            "name": "native-gcc-no-exceptions-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "native-gcc-no-exceptions",
            "configuration": "Debug"
        },
        {
            "name": "native-clang-libcxx-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "native-clang-libcxx",
            "configuration": "Debug"
        },
        {
            "name": "macos-clang-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "macos-clang",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "windows-msvc",
            "configuration": "Debug"
        },
        {
            "name": "windows-clang-cl-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "windows-clang-cl",
            "configuration": "Debug"
        }
    ],
