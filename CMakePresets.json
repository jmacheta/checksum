{
    "version": 8,
    "include": [
        "cmake/common_presets.json",
        "cmake/emulator_presets.json",
        "cmake/x86_64_presets.json",
        "cmake/benchmark_presets.json"
    ],
    "configurePresets": [
        {
            "name": "native-gcc",
            "displayName": "Linux native (GCC)",
            "description": "Native Linux build using GCC",
            "inherits": "gcc"
        },
        {
            "name": "native-clang",
            "displayName": "Linux native (Clang)",
            "description": "Native Linux build using Clang",
            "inherits": "clang"
        },
        {
            "name": "native-asan",
            "displayName": "Linux native (ASan+UBSan)",
            "description": "Native Linux build instrumented with AddressSanitizer and UndefinedBehaviorSanitizer, for tests",
            "inherits": "gcc-clang-common",
            "cacheVariables": {
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -Wl,--gc-sections"
            },
            "environment": {
                "CHECKSUM_GCC_WARNINGS": "",
                "CHECKSUM_EXTRA_CFLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -g -O1",
                "CHECKSUM_EXTRA_CXXFLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -g -O1"
            }
        },
        {
            "name": "native-gcc-no-exceptions",
            "displayName": "Linux native (GCC, -fno-exceptions -fno-rtti)",
            "description": "Native Linux build using GCC with exceptions and RTTI disabled in every target",
            "inherits": "native-gcc",
            "environment": {
                "CHECKSUM_EXTRA_CXXFLAGS": "-fno-exceptions -fno-rtti"
            }
        },
        {
            "name": "native-gcc-portable",
            "displayName": "Linux native (GCC, portable loops)",
            "description": "Native Linux build using GCC with CHECKSUM_ACCELERATION=OFF: generic architecture header, portable loops only",
            "inherits": "native-gcc",
            "cacheVariables": {
                "CHECKSUM_ACCELERATION": "OFF"
            }
        },
        {
            "name": "native-clang-libcxx",
            "displayName": "Linux native (Clang, libc++)",
            "description": "Native Linux build using Clang and libc++",
            "inherits": "native-clang",
            "environment": {
                "CHECKSUM_EXTRA_CXXFLAGS": "-stdlib=libc++"
            },
            "cacheVariables": {
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -Wl,--gc-sections"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "native-gcc-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-gcc",
            "configuration": "Debug"
        },
        {
            "name": "native-gcc-release",
            "displayName": "all [Release]",
            "configurePreset": "native-gcc",
            "configuration": "Release"
        },
        {
            "name": "native-clang-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-clang",
            "configuration": "Debug"
        },
        {
            "name": "native-clang-release",
            "displayName": "all [Release]",
            "configurePreset": "native-clang",
            "configuration": "Release"
        },
        {
            "name": "native-asan-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-asan",
            "configuration": "Debug"
        },
        {
            "name": "native-gcc-no-exceptions-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-gcc-no-exceptions",
            "configuration": "Debug"
        },
        {
            "name": "native-gcc-portable-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-gcc-portable",
            "configuration": "Debug"
        },
        {
            "name": "native-clang-libcxx-debug",
            "displayName": "all [Debug]",
            "configurePreset": "native-clang-libcxx",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "native-gcc-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "native-gcc",
            "configuration": "Debug"
        },
        {
            "name": "native-clang-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "native-clang",
            "configuration": "Debug"
        },
        {
            "name": "native-asan-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug, ASan+UBSan]",
            "configurePreset": "native-asan",
            "configuration": "Debug"
        },
        {
            "name": "native-gcc-no-exceptions-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "native-gcc-no-exceptions",
            "configuration": "Debug"
        },
        {
            "name": "native-gcc-portable-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "native-gcc-portable",
            "configuration": "Debug"
        },
        {
            "name": "native-clang-libcxx-debug",
            "inherits": "test-common",
            "displayName": "Run Tests [Debug]",
            "configurePreset": "native-clang-libcxx",
            "configuration": "Debug"
        }
    ],
    "workflowPresets": [
        {
            "name": "native-gcc",
            "displayName": "Linux native (GCC)",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "native-gcc"
                },
                {
                    "type": "build",
                    "name": "native-gcc-debug"
                },
                {
                    "type": "test",
                    "name": "native-gcc-debug"
                }
            ]
        },
        {
            "name": "native-clang",
            "displayName": "Linux native (Clang)",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "native-clang"
                },
                {
                    "type": "build",
                    "name": "native-clang-debug"
                },
                {
                    "type": "test",
                    "name": "native-clang-debug"
                }
            ]
        },
        {
            "name": "native-asan",
            "displayName": "Linux native (ASan+UBSan)",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "native-asan"
                },
                {
                    "type": "build",
                    "name": "native-asan-debug"
                },
                {
                    "type": "test",
                    "name": "native-asan-debug"
                }
            ]
        },
        {
            "name": "native-gcc-no-exceptions",
            "displayName": "Linux native (GCC, -fno-exceptions -fno-rtti)",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "native-gcc-no-exceptions"
                },
                {
                    "type": "build",
                    "name": "native-gcc-no-exceptions-debug"
                },
                {
                    "type": "test",
                    "name": "native-gcc-no-exceptions-debug"
                }
            ]
        },
        {
            "name": "native-gcc-portable",
            "displayName": "Linux native (GCC, portable loops)",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "native-gcc-portable"
                },
                {
                    "type": "build",
                    "name": "native-gcc-portable-debug"
                },
                {
                    "type": "test",
                    "name": "native-gcc-portable-debug"
                }
            ]
        },
        {
            "name": "native-clang-libcxx",
            "displayName": "Linux native (Clang, libc++)",
            "description": "Configure, build [Debug], test",
            "steps": [
                {
                    "type": "configure",
                    "name": "native-clang-libcxx"
                },
                {
                    "type": "build",
                    "name": "native-clang-libcxx-debug"
                },
                {
                    "type": "test",
                    "name": "native-clang-libcxx-debug"
                }
            ]
        }
    ]
}
